# NVIDIA_API_KEY: Optional API key for direct NVIDIA NIM free endpoints (https://integrate.api.nvidia.com/v1).
# Obtain a free key from https://build.nvidia.com and configure it in the AI Studio Secrets panel.
# Firebase AI Logic (Gemini + Google Search + Vision) works automatically without any API key.
NVIDIA_API_KEY=MY_NVIDIA_NIM_API_KEY
